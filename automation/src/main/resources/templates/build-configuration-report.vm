<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <title>Build Configuration Report - $request.rootProjectId</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Inter, Arial, sans-serif;
            margin: 0;
            padding: 24px;
            background: #f3f5f9;
            color: #172033;
        }

        h1,
        h2,
        p {
            margin-top: 0;
        }

        h2 {
            margin: 28px 0 12px;
            color: #0f172a;
            font-size: 18px;
        }

        a {
            color: #174a9c;
            text-decoration: none;
        }

        a:hover {
            text-decoration: underline;
        }

        .mono {
            font-family: Consolas, monospace;
            font-size: 12px;
        }

        .report-hero {
            margin-bottom: 24px;
            padding: 24px;
            background: #ffffff;
            border: 1px solid #d4dbe6;
            border-radius: 14px;
            box-shadow: 0 4px 18px rgba(15, 23, 42, 0.05);
        }

        .hero-top {
            margin-bottom: 20px;
        }

        .hero-eyebrow {
            margin-bottom: 6px;
            color: #526076;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
        }

        .hero-title {
            margin: 0;
            color: #0f172a;
            font-size: 28px;
            line-height: 1.2;
            letter-spacing: -.02em;
        }

        .hero-subtitle {
            max-width: 720px;
            margin: 8px 0 0;
            color: #526076;
            font-size: 14px;
            line-height: 1.5;
        }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(5, minmax(120px, 1fr));
            gap: 12px;
            margin-bottom: 16px;
        }

        .summary-card {
            min-width: 0;
            padding: 15px 18px;
            background: #ffffff;
            border: 1px solid #d7dee8;
            border-radius: 12px;
        }

        .summary-label {
            margin-bottom: 7px;
            color: #526076;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .05em;
            text-transform: uppercase;
        }

        .summary-value {
            color: #0f172a;
            font-size: 24px;
            font-weight: 800;
            line-height: 1;
        }

        .summary-card.success .summary-value {
            color: #2e7d32;
        }

        .summary-card.error .summary-value {
            color: #c62828;
        }

        .summary-card.warning .summary-value {
            color: #ef6c00;
        }

        .hero-details {
            display: block;
        }

        .detail-card {
            padding: 18px 20px;
            background: #ffffff;
            border: 1px solid #d8dee8;
            border-radius: 12px;
        }

        .request-details {
            width: 100%;
        }

        .detail-title {
            margin: 0 0 16px;
            padding-bottom: 10px;
            border-bottom: 1px solid #e5e7eb;
            color: #27364a;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .05em;
            text-transform: uppercase;
        }

        .detail-list {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 13px 20px;
        }

        .detail-label {
            display: block;
            margin-bottom: 4px;
            color: #526076;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .05em;
            text-transform: uppercase;
        }

        .detail-value {
            display: block;
            min-width: 0;
            color: #0f172a;
            font-size: 14px;
            font-weight: 600;
            line-height: 1.45;
            overflow-wrap: anywhere;
        }

        .scope-block + .scope-block {
            margin-top: 14px;
        }

        .scope-label {
            display: block;
            margin-bottom: 8px;
            color: #526076;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .05em;
            text-transform: uppercase;
        }

        .chip-list {
            display: flex;
            flex-wrap: wrap;
            gap: 7px;
        }

        .chip {
            display: inline-flex;
            align-items: center;
            max-width: 100%;
            padding: 6px 10px;
            background: #ffffff;
            border: 1px solid #d4dbe6;
            border-radius: 8px;
            color: #27364a;
            font-family: Consolas, monospace;
            font-size: 12px;
            font-weight: 600;
            line-height: 1.3;
            overflow-wrap: anywhere;
        }

        .hero-muted {
            color: #526076;
            font-size: 12px;
        }

        .table-wrap {
            overflow: auto;
            max-height: 85vh;
            width: 100%;
            margin-bottom: 24px;
            background: #ffffff;
            border: 1px solid #d4dbe6;
            border-radius: 14px;
            box-shadow: 0 4px 18px rgba(15, 23, 42, 0.05);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
        }

        th,
        td {
            border: 1px solid #dcdcdc;
            padding: 8px;
            vertical-align: top;
            min-width: 0;
            overflow-wrap: anywhere;
            word-break: break-word;
            box-sizing: border-box;
        }

        th {
            position: sticky;
            top: 0;
            z-index: 2;
            user-select: none;
            background: #f0f0f0;
            color: #0f172a;
            font-weight: 700;
        }

        tbody tr:nth-child(even) td {
            background: #fafafa;
        }

        .component-cell {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .component-name {
            font-weight: 700;
        }

        .muted {
            color: #526076;
            font-size: 12px;
        }

        .check-fail {
            background: #ffebee !important;
            color: #c62828;
        }

        .check-value {
            font-weight: 700;
        }

        .status-badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 999px;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        .status-ok {
            background: #e8f5e9;
            color: #2e7d32;
        }

        .status-warning {
            background: #fff4e5;
            color: #ef6c00;
        }

        .empty-state {
            padding: 16px;
            color: #526076;
            background: #ffffff;
            border: 1px solid #d4dbe6;
            border-radius: 12px;
        }

        @media (max-width: 1100px) {
            .summary-grid {
                grid-template-columns: repeat(3, minmax(150px, 1fr));
            }
        }

        @media (max-width: 760px) {
            body {
                padding: 16px;
            }

            .report-hero {
                padding: 18px;
            }

            .summary-grid {
                grid-template-columns: 1fr;
            }

            .detail-list {
                grid-template-columns: 1fr;
            }
        }

    </style>
</head>

<body>
    #set($okComponents = [])
    #set($failedComponents = [])
    #set($successfulComponents = [])
    #set($noProjectComponents = [])
    #set($noBuildConfigComponents = [])

    #foreach($component in $result)
        #if($component.status.name() == "OK")
            #set($dummy = $okComponents.add($component))

            #set($hasFailedCheck = false)
            #foreach($check in $component.checks)
                #if(!$check.status)
                    #set($hasFailedCheck = true)
                #end
            #end

            #if($hasFailedCheck)
                #set($dummy = $failedComponents.add($component))
            #else
                #set($dummy = $successfulComponents.add($component))
            #end
        #elseif($component.status.name() == "NO_PROJECT")
            #set($dummy = $noProjectComponents.add($component))
        #else
            #set($dummy = $noBuildConfigComponents.add($component))
        #end
    #end

    #macro(formatValue $value)
        #set($stringValue = "$!value")

        #if($stringValue == "" || $stringValue == "null")
        <span class="muted">not specified</span>
        #elseif($stringValue == "NOT_DEFINED")
        <span class="muted">not defined</span>
        #elseif($stringValue == "ENABLED")
        <span class="check-value">enabled</span>
        #elseif($stringValue == "DISABLED")
        <span class="check-value">disabled</span>
        #else
        <span class="check-value">$stringValue</span>
        #end
    #end


<header class="report-hero">
    <div class="hero-top">
        <div>
            <div class="hero-eyebrow">Build validation</div>
            <h1 class="hero-title">Build Configuration Report</h1>
            <p class="hero-subtitle">
                Configuration coverage and validation results for
                <strong>$request.rootProjectId</strong>.
            </p>
        </div>
    </div>

    <div class="summary-grid">
        <div class="summary-card">
            <div class="summary-label">Total Components</div>
            <div class="summary-value">$result.size()</div>
        </div>

        <div class="summary-card success">
            <div class="summary-label">Successful</div>
            <div class="summary-value">$successfulComponents.size()</div>
        </div>

        <div class="summary-card error">
            <div class="summary-label">Failed Checks</div>
            <div class="summary-value">$failedComponents.size()</div>
        </div>

        <div class="summary-card warning">
            <div class="summary-label">No Project</div>
            <div class="summary-value">$noProjectComponents.size()</div>
        </div>

        <div class="summary-card warning">
            <div class="summary-label">No Build Config</div>
            <div class="summary-value">$noBuildConfigComponents.size()</div>
        </div>
    </div>

    <div class="hero-details">
        <section class="detail-card request-details">
            <h2 class="detail-title">Request Details</h2>

            <div class="detail-list">
                <div>
                    <span class="detail-label">Root Project</span>
                    <span class="detail-value mono">$request.rootProjectId</span>
                </div>

                <div>
                    <span class="detail-label">Build Stage</span>
                    <span class="detail-value mono">$!request.checks.buildStage</span>
                </div>

                <div>
                    <span class="detail-label">Include Systems</span>
                    <span class="detail-value">
                        #if($request.componentsFilter.includeSystems.size() > 0)
                            #foreach($s in $request.componentsFilter.includeSystems)
                                $s#if($foreach.hasNext), #end
                            #end
                        #else
                            <span class="hero-muted">—</span>
                        #end
                    </span>
                </div>

                <div>
                    <span class="detail-label">Excluded Components</span>
                    <span class="detail-value">
                        #if($request.componentsFilter.excludeComponents.size() > 0)
                            #foreach($c in $request.componentsFilter.excludeComponents)
                                $c#if($foreach.hasNext), #end
                            #end
                        #else
                            <span class="hero-muted">—</span>
                        #end
                    </span>
                </div>
            </div>

            <div class="scope-block">
                <span class="scope-label">Check Parameters</span>

                <div class="chip-list">
                    #if($request.checks.parameters.size() > 0)
                        #foreach($p in $request.checks.parameters)
                            <span class="chip">$p</span>
                        #end
                    #else
                        <span class="hero-muted">No parameters specified</span>
                    #end
                </div>
            </div>

            <div class="scope-block">
                <span class="scope-label">Check Steps</span>

                <div class="chip-list">
                    #if($request.checks.steps.size() > 0)
                        #foreach($st in $request.checks.steps)
                            <span class="chip">$st</span>
                        #end
                    #else
                        <span class="hero-muted">No steps specified</span>
                    #end
                </div>
            </div>
        </section>
    </div>

</header>


    #if($failedComponents.size() > 0)
    <h2>Failed Checks</h2>

    <div class="table-wrap">
        <table id="failedChecksTable">
            <colgroup>
                <col style="width: 24%;">
                <col style="width: 16%;">
                <col style="width: 20%;">
                <col style="width: 20%;">
                <col style="width: 20%;">
            </colgroup>

            <thead>
            <tr>
                <th>Component</th>
                <th>Check Type</th>
                <th>Check</th>
                <th>Actual Value</th>
                <th>Expected Value</th>
            </tr>
            </thead>

            <tbody>
                #foreach($component in $failedComponents)
                    #foreach($check in $component.checks)
                        #if(!$check.status)
                        <tr>
                            <td>
                                <div class="component-cell">
                                    #if($component.buildConfigurationUrl)
                                        <a class="component-name" href="$component.buildConfigurationUrl" target="_blank" rel="noopener noreferrer">
                                            $component.componentId
                                        </a>
                                    #else
                                        <span class="component-name">$component.componentId</span>
                                    #end

                                    #if($component.buildTypeId)
                                        <span class="muted mono">$component.buildTypeId</span>
                                    #end
                                </div>
                            </td>

                            <td>$check.checkType</td>

                            <td>$check.checkName</td>

                            <td class="check-fail">
                                #formatValue($check.actualValue)
                            </td>

                            <td>
                                #formatValue($check.expectedValue)
                            </td>
                        </tr>
                        #end
                    #end
                #end
            </tbody>
        </table>
    </div>
    #end

    #if($noBuildConfigComponents.size() > 0)
    <h2>Components without Build Configuration</h2>

    <div class="table-wrap">
        <table id="noBuildConfigTable">
            <colgroup>
                <col style="width: 75%;">
                <col style="width: 25%;">
            </colgroup>

            <thead>
            <tr>
                <th>Component</th>
                <th>Status</th>
            </tr>
            </thead>

            <tbody>
                #foreach($component in $noBuildConfigComponents)
                <tr>
                    <td>$component.componentId</td>
                    <td>
                        <span class="status-badge status-warning">NO_BUILD_CONFIGURATION</span>
                    </td>
                </tr>
                #end
            </tbody>
        </table>
    </div>
    #end

    #if($noProjectComponents.size() > 0)
    <h2>Components without Project</h2>

    <div class="table-wrap">
        <table id="noProjectTable">
            <colgroup>
                <col style="width: 75%;">
                <col style="width: 25%;">
            </colgroup>

            <thead>
            <tr>
                <th>Component</th>
                <th>Status</th>
            </tr>
            </thead>

            <tbody>
                #foreach($component in $noProjectComponents)
                <tr>
                    <td>$component.componentId</td>
                    <td>
                        <span class="status-badge status-warning">NO_PROJECT</span>
                    </td>
                </tr>
                #end
            </tbody>
        </table>
    </div>
    #end

    #if($successfulComponents.size() > 0)
    <h2>Successful Components</h2>

    <div class="table-wrap">
        <table id="successfulComponentsTable">
            <colgroup>
                <col style="width: 24%;">
                <col style="width: 14%;">
                <col style="width: 18%;">
                <col style="width: 18%;">
                <col style="width: 18%;">
                <col style="width: 8%;">
            </colgroup>

            <thead>
            <tr>
                <th>Component</th>
                <th>Check Type</th>
                <th>Check</th>
                <th>Actual Value</th>
                <th>Expected Value</th>
                <th>Status</th>
            </tr>
            </thead>

            <tbody>
                #foreach($component in $successfulComponents)
                    #foreach($check in $component.checks)
                    <tr>
                        <td>
                            <div class="component-cell">
                                #if($component.buildConfigurationUrl)
                                    <a class="component-name"
                                       href="$component.buildConfigurationUrl"
                                       target="_blank"
                                       rel="noopener noreferrer">
                                        $component.componentId
                                    </a>
                                #else
                                    <span class="component-name">$component.componentId</span>
                                #end

                                #if($component.buildTypeId)
                                    <span class="muted mono">$component.buildTypeId</span>
                                #end
                            </div>
                        </td>

                        <td>$check.checkType</td>
                        <td>$check.checkName</td>
                        <td>#formatValue($check.actualValue)</td>
                        <td>#formatValue($check.expectedValue)</td>
                        <td>
                            <span class="status-badge status-ok">OK</span>
                        </td>
                    </tr>
                    #end
                #end
            </tbody>
        </table>
    </div>
    #end

    #if($failedComponents.size() == 0 && $noBuildConfigComponents.size() == 0 && $noProjectComponents.size() == 0 && $successfulComponents.size() == 0)
    <div class="empty-state">No components found.</div>
    #end

</body>
</html>